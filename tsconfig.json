{ 
  "extends": "@tsconfig/recommended",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "target": "es2017",
    "verbatimModuleSyntax": true
  }
}
