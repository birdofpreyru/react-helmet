{
  "extends": "@tsconfig/recommended",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noUncheckedIndexedAccess": true,
    "outDir": "build",
    "rootDir": "src",
    "target": "es2017",
    "verbatimModuleSyntax": true
  },
  "include": ["src"]
}
